PORT=3000
DB_PATH=./cloudphone.sqlite
# Generate a unique random secret (at least 32 characters). Keep it private.
SESSION_SECRET=replace-with-a-long-random-secret-before-deploying
# Comma-separated user IDs that should receive admin privileges after bootstrap.
ADMIN_USER_IDS=

# Alibaba Cloud Phone (EDS-AIC). Keep these values in hosting secrets, never in GitHub.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION=ap-southeast-1
